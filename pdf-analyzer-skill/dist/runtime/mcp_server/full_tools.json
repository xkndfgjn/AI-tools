[
    {
        "name": "pdf_extract_text",
        "description": "读取本地PDF，提取页面文本，支持指定页码范围；传入文件绝对路径",
        "inputSchema": {
            "type": "object",
            "properties": {
                "file_path": {
                    "type": "string",
                    "description": "PDF本地绝对路径"
                },
                "page_start": {
                    "type": "integer",
                    "description": "起始页码，0为第一页",
                    "default": 0
                },
                "page_end": {
                    "type": "integer",
                    "description": "结束页码，-1读取全部",
                    "default": -1
                }
            },
            "required": [
                "file_path"
            ]
        }
    },
    {
        "name": "pdf_get_metadata",
        "description": "获取PDF元数据，作者、标题、页数等",
        "inputSchema": {
            "type": "object",
            "properties": {
                "file_path": {
                    "type": "string",
                    "description": "PDF本地绝对路径"
                }
            },
            "required": [
                "file_path"
            ]
        }
    },
    {
        "name": "pdf_page_count",
        "description": "获取PDF文档总页数",
        "inputSchema": {
            "type": "object",
            "properties": {
                "file_path": {
                    "type": "string",
                    "description": "PDF本地绝对路径"
                }
            },
            "required": [
                "file_path"
            ]
        }
    },
    {
        "name": "pdf_extract_images",
        "description": "提取PDF指定页面内全部图片，保存到本地输出目录；输入源pdf路径、输出目录路径",
        "inputSchema": {
            "type": "object",
            "properties": {
                "file_path": {
                    "type": "string",
                    "description": "源PDF绝对路径"
                },
                "output_dir": {
                    "type": "string",
                    "description": "图片输出文件夹绝对路径"
                },
                "page_start": {
                    "type": "integer",
                    "description": "起始页0为第一页",
                    "default": 0
                },
                "page_end": {
                    "type": "integer",
                    "description": "结束页，-1全部页面",
                    "default": -1
                }
            },
            "required": [
                "file_path",
                "output_dir"
            ]
        }
    },
    {
        "name": "pdf_split",
        "description": "分割PDF，截取指定页码范围生成新PDF文件；page_start/page_end从0开始",
        "inputSchema": {
            "type": "object",
            "properties": {
                "file_path": {
                    "type": "string",
                    "description": "源PDF绝对路径"
                },
                "output_file": {
                    "type": "string",
                    "description": "输出新PDF完整绝对路径"
                },
                "page_start": {
                    "type": "integer",
                    "description": "起始页码0开始"
                },
                "page_end": {
                    "type": "integer",
                    "description": "结束页码(包含)"
                }
            },
            "required": [
                "file_path",
                "output_file",
                "page_start",
                "page_end"
            ]
        }
    },
    {
        "name": "pdf_merge",
        "description": "合并多个PDF文件，按列表顺序拼接，输出新PDF",
        "inputSchema": {
            "type": "object",
            "properties": {
                "input_pdf_list": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "待合并pdf绝对路径数组，顺序即合并顺序"
                },
                "output_file": {
                    "type": "string",
                    "description": "合并后输出pdf完整绝对路径"
                }
            },
            "required": [
                "input_pdf_list",
                "output_file"
            ]
        }
    },
    {
        "name": "pdf_search_keywords",
        "description": "在PDF中搜索关键词，返回命中页码和上下文片段（大小写不敏感）",
        "inputSchema": {
            "type": "object",
            "properties": {
                "file_path": {
                    "type": "string",
                    "description": "PDF本地绝对路径"
                },
                "keywords": {
                    "type": "string",
                    "description": "搜索关键词，逗号分隔多个，如 hello,world"
                },
                "page_start": {
                    "type": "integer",
                    "description": "起始页码，0为第一页",
                    "default": 0
                },
                "page_end": {
                    "type": "integer",
                    "description": "结束页码，-1搜索全部",
                    "default": -1
                }
            },
            "required": [
                "file_path",
                "keywords"
            ]
        }
    }
]
