{
  "name": "pdf_analyzer",
  "description": "PDF解析：提取文本/OCR/摘要",
  "instructions": "这是一个 PDF 分析技能包。主要用于处理 PDF 文本提取、OCR 识别、摘要生成和相关分析任务。项目结构包含 plugin 配置、安装脚本、构建脚本、运行时服务和 MCP 服务器。使用时优先查看 plugin.json、build_min_skill.py、skills/pdf_analyzer/skill.json 和 runtime 目录中的实现。",
  "tools": [
    {
      "name": "pdf_txt",
      "description": "提取PDF文本",
      "parameters": {
        "type": "object",
        "properties": {
          "fp": {
            "type": "string",
            "description": "pdf绝对路径"
          },
          "pr": {
            "type": "string",
            "description": "页码1‑3"
          },
          "ocr": {
            "type": "boolean",
            "description": "扫描件OCR"
          }
        },
        "required": ["fp"]
      },
      "hanako": {
        "invoke": {
          "shell": [
            "python",
            "{{plugin_runtime}}/proxy.py",
            "pdf_txt",
            "{{{json(args)}}}"
          ]
        }
      }
    },
    {
      "name": "pdf_sum",
      "description": "PDF摘要",
      "parameters": {
        "type": "object",
        "properties": {
          "fp": {
            "type": "string",
            "description": "pdf路径"
          },
          "len": {
            "type": "integer",
            "description": "摘要长度"
          }
        },
        "required": ["fp"]
      },
      "hanako": {
        "invoke": {
          "shell": [
            "python",
            "{{plugin_runtime}}/proxy.py",
            "pdf_sum",
            "{{{json(args)}}}"
          ]
        }
      }
    }
  ]
}